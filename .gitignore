# Python bytecode
__pycache__/
*.py[cod]
*.so
*.pyd
*.pyo

# Secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
.venv-papers-replication/
env/
venv/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Notebooks — ignore all except the ViT showcase notebook.
*.ipynb
!ViT/ViT.ipynb

# System files (macOS)
.DS_Store

# IDE/editor settings
.vscode/
.idea/

# Logs and temp files
*.log
*.tmp
*.bak
*.swp

# Build outputs
build/
dist/
*.egg-info/

# Pytest cache
.pytest_cache/

# Dataset and data folders (optional: include if large or unnecessary to track)
dataset/test
dataset/train
data/

# uv or pip-lock file (optional: ignore if you want fresh install on every clone)
uv.lock

# Models
ViT/models

# Training artifacts — runtime outputs, not source.
# `.pt` files in `released/` (or anywhere else) still go through LFS via .gitattributes.
checkpoints/
logs/

# Generated preprocessing assets — rebuilt from the dataset on first run.
tokenizer/
# streamed corpus .txt (bn_wiki.txt etc.) — regenerated by prepare_corpus.py
BERT/data/

# Private corpus filter — not shipped publicly
BERT/scripts/_corpus_filter.py

# --- Docs, articles, scratch notes: kept locally, not published to the repo ---
# The blog is the canonical home for the long-form write-ups.
ARTICLE.md

# Scratch / personal notes (any dir): theory dumps, command cheatsheets.
just_for_knowledge.md
command_to_remember.md

# Verbose per-module docs — superseded by docs/{getting-started,training,architecture}.md.
# The three standardized top-level docs/*.md stay tracked (only the subdirs are ignored).
BERT/docs/architecture/
BERT/docs/modules/
BERT/docs/objectives/
BERT/docs/scripts/
BERT/docs/utils/
transformer/docs/architecture/
transformer/docs/modules/
transformer/docs/scripts/
transformer/docs/utils/

# Doc/article figures. ViT/markdown_images/ is intentionally NOT ignored —
# the tracked showcase notebook (ViT/ViT.ipynb) embeds those images.
BERT/markdown_images/
transformer/markdown_images/

# gradio
.gradio

# Claude Code's guide
CLAUDE.md